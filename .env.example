# --- Alpaca paper (separate account from DCATradeBot) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# --- Alpaca live (only used when LIVE_TRADING=true) ---
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# --- Database ---
DATABASE_URL=

# --- Capital / portfolio ---
# Total deployed paper capital for the aggressive sleeve (does not include
# DCA bot's separate pool).
PORTFOLIO_USD=37500

# --- Risk-management layer ---
# Max risk per trade as fraction of portfolio (Kelly-lite, capped at 2%)
RISK_PER_TRADE_PCT=0.02
# Max simultaneously-open positions across ALL strategies
MAX_CONCURRENT_POSITIONS=5
# ATR multiplier for stop-loss distance
ATR_STOP_MULT=1.5
# Kill switch: trading pauses for the rest of the month if drawdown breaches
KILL_SWITCH_DRAWDOWN_PCT=0.15

# --- Strategy allocation weights (must sum to <= 1.0) ---
# Reflects the original plan minus funding-arb (US/spot constraint).
# Cash reserve (5%) sits idle; the remaining 5% from dropping funding-arb
# folds into mean-reversion.
WEIGHT_MOMENTUM=0.35
WEIGHT_MEAN_REVERSION=0.25
WEIGHT_TREND_FOLLOWING=0.30
WEIGHT_ALT_SPECULATION=0.05
WEIGHT_CASH_RESERVE=0.05

# --- Universe ---
# Comma-separated. Start with BTC + ETH; expand carefully.
SYMBOLS=BTC/USD,ETH/USD

# --- Cron (default: every 4 hours on the hour) ---
# Strategies self-gate on their own timeframes — the cron is the heartbeat.
CRON_SCHEDULE=0 */4 * * *
TZ=UTC

# --- Safety ---
LIVE_TRADING=false
APPROVAL_TIMEOUT_MIN=30
APPROVAL_SECRET=
NIA_WEBHOOK_URL=
PUBLIC_APPROVE_BASE_URL=

# --- Dashboard ---
UI_ENABLED=true
UI_PORT=8080
UI_USER=admin
UI_PASS=change-me-long-random
